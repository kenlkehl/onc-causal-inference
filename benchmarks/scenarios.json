      "family": "S0",
      "label": "Baseline",
      "factor": "Confounders and effect modifiers only, as in the generator's default process",
      "materialization": "reequation",
      "sizes": [1000, 5000, 10000],
      "source": {
        "kind": "reequation_source",
        "minimum_patients": 10000,
        "requirements": "dataset.parquet, metadata.json and generation_config.json; a true_<variable> column for every metadata feature; at least 6 features; no post-treatment notes"
      },
      "dgp": {
        "name": "S0_baseline",
        "roles": {"confounder": 3, "effect_modifier": 3},
        "role_assignment": "random",
        "modifier_main_effects": false,
        "nonlinearity": "none",
        "treatment_logit_std": 2.0,
        "outcome_logit_std": 2.0,
        "treatment_effect": 0.2,
        "modifier_strength": 2.0,
        "unmeasured_confounders": 0,
        "unmeasured_strength": 1.0,
        "target_treatment_rate": 0.5,
        "target_control_outcome_rate": 0.5,
        "outcome_noise_std": 1.0
      },
      "run_variants": [{"name": "default", "description": "the cohort's clinical_text column"}]
    },
