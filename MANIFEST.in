include README.md
include LICENSE
include pyproject.toml
include run_synthetic.sh
include run_sample_size_calculator.sh
recursive-include example_configs *.json
recursive-include docs *.md
recursive-include scripts *.py *.env
recursive-include synthetic_data *.py
recursive-include synthetic_data/designs *.json
