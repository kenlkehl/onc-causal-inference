# Eight RTX PRO 6000 Blackwell GPUs (96 GB each).  OCI manages the vLLM
# servers.  By default both Stage 2 roles use the same NVFP4 Gemma model, so
# Stage 2 serves it as one pool over all eight GPUs (one server per GPU).  If
# STAGE2_MODEL names a different model, the two models alternate across the
# GPUs instead, using GPUs 0-3 (primary) and 4-7 (extraction) as the fallback
# split.  GPU indices are logical, after any CUDA_VISIBLE_DEVICES or
# PHYSICAL_GPUS mapping.  Sourced by run_synthetic.sh for fresh runs only;
# variables that are already set keep their values.
if [[ -z "${PHYSICAL_GPUS:-}" ]]; then
    : "${GPU_COUNT:=8}"
fi
# NVIDIA omits IT from this repository name; the checkpoint is instruction tuned.
: "${STAGE2_EXTRACTION_MODEL:=nvidia/Gemma-4-26B-A4B-NVFP4}"
: "${STAGE2_MODEL:=${STAGE2_EXTRACTION_MODEL}}"
: "${STAGE2_VLLM_GPUS:=cuda:0,cuda:1,cuda:2,cuda:3}"
: "${STAGE2_EXTRACTION_VLLM_GPUS:=cuda:4,cuda:5,cuda:6,cuda:7}"
# Keep tensor parallelism at 1, the supported vLLM layout for this checkpoint.
: "${STAGE2_VLLM_GPUS_PER_SERVER:=1}"
: "${STAGE2_EXTRACTION_VLLM_GPUS_PER_SERVER:=1}"
: "${STAGE2_VLLM_RAPID_SWITCH_SECONDS:=900}"
: "${STAGE2_VLLM_BASE_PORT:=8010}"
: "${STAGE2_EXTRACTION_VLLM_BASE_PORT:=8110}"
: "${STAGE2_VLLM_INTERNAL_PORT_BASE:=20000}"
: "${STAGE2_EXTRACTION_VLLM_INTERNAL_PORT_BASE:=30000}"
: "${STAGE2_WORKERS:=32}"
: "${STAGE2_EXTRACTION_WORKERS:=32}"
: "${STAGE2_MODELING_WORKERS:=128}"
: "${STAGE2_REQUEST_ATTEMPT_TIMEOUT:=1800}"
: "${STAGE2_REQUEST_TIMEOUT:=6000}"
# Gemma's native 256K window.  Prompt and output share it, including the
# primary role's 100,000-token output allowance.
: "${STAGE2_EXTRACTION_CONTEXT_WINDOW_TOKENS:=262144}"
: "${STAGE2_EXTRACTION_CONTEXT_MARGIN_TOKENS:=4096}"
# vLLM reads NVFP4 (ModelOpt) quantization from the checkpoint.  Managed Gemma
# servers add --language-model-only and the gemma4 reasoning parser themselves.
rtx_vllm_args='["--gpu-memory-utilization","0.90","--max-model-len","262144","--max-num-seqs","32"]'
: "${STAGE2_VLLM_EXTRA_ARGS_JSON:=${rtx_vllm_args}}"
: "${STAGE2_EXTRACTION_VLLM_EXTRA_ARGS_JSON:=${rtx_vllm_args}}"
