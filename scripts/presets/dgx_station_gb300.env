# NVIDIA DGX Station with the GB300 Grace Blackwell Ultra Desktop Superchip:
# one Blackwell Ultra GPU (252 GB HBM3e) and a 72-core Grace (Arm) CPU.  The
# station's optional RTX PRO display GPU comes first in PCI order, so the GB300
# is GPU 1 in nvidia-smi.  CUDA's default order (fastest first) can number the
# GPUs differently, so this preset switches CUDA to PCI order and selects
# physical GPU 1.  On a station without a display GPU, set PHYSICAL_GPUS=0.
# Stage 1 and both Stage 2 roles run on the GB300: OCI serves one NVFP4 Gemma
# model as one shared vLLM server.  GPU indices below are logical, after the
# PHYSICAL_GPUS mapping.  Sourced by run_synthetic.sh for fresh runs only;
# variables that are already set keep their values.
export CUDA_DEVICE_ORDER="${CUDA_DEVICE_ORDER:-PCI_BUS_ID}"
: "${PHYSICAL_GPUS:=1}"
# A display GPU has at most 96 GB in total, so selecting it instead of the
# GB300 stops the launch at GPU detection.  (Total, not free, memory: a vLLM
# server on the GB300 leaves Stage 1 less than this free.)
: "${MIN_TOTAL_GPU_GB:=150}"
# Independent HTR/text-model and neural-query contexts share the large GPU.
# Each context gets a separate process and a share of the Stage 1 CPU budget.
: "${STAGE1_CONTEXTS_PER_GPU:=4}"
# NVIDIA omits IT from this repository name; the checkpoint is instruction tuned.
: "${STAGE2_EXTRACTION_MODEL:=nvidia/Gemma-4-26B-A4B-NVFP4}"
: "${STAGE2_MODEL:=${STAGE2_EXTRACTION_MODEL}}"
: "${STAGE2_VLLM_GPUS:=cuda:0}"
: "${STAGE2_EXTRACTION_VLLM_GPUS:=cuda:0}"
: "${STAGE2_VLLM_GPUS_PER_SERVER:=1}"
: "${STAGE2_EXTRACTION_VLLM_GPUS_PER_SERVER:=1}"
: "${STAGE2_VLLM_RAPID_SWITCH_SECONDS:=900}"
: "${STAGE2_VLLM_BASE_PORT:=8010}"
: "${STAGE2_EXTRACTION_VLLM_BASE_PORT:=8110}"
: "${STAGE2_VLLM_INTERNAL_PORT_BASE:=20000}"
: "${STAGE2_EXTRACTION_VLLM_INTERNAL_PORT_BASE:=30000}"
: "${STAGE2_WORKERS:=32}"
: "${STAGE2_EXTRACTION_WORKERS:=32}"
: "${STAGE2_MODELING_WORKERS:=64}"
: "${STAGE2_REQUEST_ATTEMPT_TIMEOUT:=1800}"
: "${STAGE2_REQUEST_TIMEOUT:=6000}"
# Gemma's native 256K window.  Prompt and output share it, including the
# primary role's 100,000-token output allowance.
: "${STAGE2_EXTRACTION_CONTEXT_WINDOW_TOKENS:=262144}"
: "${STAGE2_EXTRACTION_CONTEXT_MARGIN_TOKENS:=4096}"
# One server takes both roles' requests (32 each), so it batches up to 64.
# vLLM reads NVFP4 (ModelOpt) quantization from the checkpoint.  Managed Gemma
# servers add --language-model-only and the gemma4 reasoning parser themselves.
gb300_vllm_args='["--gpu-memory-utilization","0.90","--max-model-len","262144","--max-num-seqs","64"]'
: "${STAGE2_VLLM_EXTRA_ARGS_JSON:=${gb300_vllm_args}}"
: "${STAGE2_EXTRACTION_VLLM_EXTRA_ARGS_JSON:=${gb300_vllm_args}}"
