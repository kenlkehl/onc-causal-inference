# Default preset: Stage 2 uses OpenAI-compatible servers that are already running.
# run_synthetic.sh sends primary-model requests to http://127.0.0.1:8010/v1 and
# extraction requests to http://127.0.0.1:8020/v1 unless STAGE2_ENDPOINT,
# STAGE2_EXTRACTION_ENDPOINT, STAGE2_EXTRACTION_ENDPOINTS, or managed vLLM
# variables say otherwise.  Sourced by run_synthetic.sh for fresh runs only;
# variables that are already set keep their values.
: "${STAGE2_MODEL:=RedHatAI/Gemma-4-31B-IT-FP8-Dynamic}"
: "${STAGE2_EXTRACTION_MODEL:=google/gemma-4-e4b-it}"
