# Eight H100 GPUs (80 GB each).  OCI starts, checks, and stops both vLLM pools:
# the primary model on GPUs 0-3 and the extraction model on GPUs 4-7, one
# server per GPU.  Because the two models differ, Stage 2 alternates them
# across all eight GPUs and keeps both resident on this split after two model
# switches closer than STAGE2_VLLM_RAPID_SWITCH_SECONDS.  GPU indices are
# logical, after any CUDA_VISIBLE_DEVICES or PHYSICAL_GPUS mapping.
# Sourced by run_synthetic.sh for fresh runs only; variables that are already
# set keep their values.
if [[ -z "${PHYSICAL_GPUS:-}" ]]; then
    : "${GPU_COUNT:=8}"
fi
: "${STAGE2_MODEL:=RedHatAI/gemma-4-31B-it-FP8-dynamic}"
: "${STAGE2_EXTRACTION_MODEL:=RedHatAI/gemma-4-26B-A4B-it-FP8-dynamic}"
: "${STAGE2_VLLM_GPUS:=cuda:0,cuda:1,cuda:2,cuda:3}"
: "${STAGE2_EXTRACTION_VLLM_GPUS:=cuda:4,cuda:5,cuda:6,cuda:7}"
: "${STAGE2_VLLM_GPUS_PER_SERVER:=1}"
: "${STAGE2_EXTRACTION_VLLM_GPUS_PER_SERVER:=1}"
: "${STAGE2_VLLM_RAPID_SWITCH_SECONDS:=900}"
: "${STAGE2_VLLM_BASE_PORT:=8010}"
: "${STAGE2_EXTRACTION_VLLM_BASE_PORT:=8110}"
: "${STAGE2_VLLM_INTERNAL_PORT_BASE:=20000}"
: "${STAGE2_EXTRACTION_VLLM_INTERNAL_PORT_BASE:=30000}"
: "${STAGE2_WORKERS:=32}"
: "${STAGE2_EXTRACTION_WORKERS:=32}"
: "${STAGE2_REQUEST_ATTEMPT_TIMEOUT:=1800}"
: "${STAGE2_REQUEST_TIMEOUT:=6000}"
# Plan extraction requests for the servers' 128,000-token window, with room for
# tokenizer differences.
: "${STAGE2_EXTRACTION_CONTEXT_WINDOW_TOKENS:=128000}"
: "${STAGE2_EXTRACTION_CONTEXT_MARGIN_TOKENS:=4096}"
# vLLM reads FP8 quantization from each checkpoint.  Managed Gemma servers add
# --language-model-only and the gemma4 reasoning parser themselves.
h100_vllm_args='["--gpu-memory-utilization","0.90","--max-model-len","128000","--max-num-seqs","32"]'
: "${STAGE2_VLLM_EXTRA_ARGS_JSON:=${h100_vllm_args}}"
: "${STAGE2_EXTRACTION_VLLM_EXTRA_ARGS_JSON:=${h100_vllm_args}}"
